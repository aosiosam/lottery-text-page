<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.0" />
    <httpRuntime targetFramework="4.0" maxRequestLength="12288" executionTimeout="90" />
  </system.web>
  <system.webServer>
    <handlers>
      <clear />
      <add name="SvitlaIsolatedProxy" path="*" verb="*" type="SvitlaProxy" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <security><requestFiltering><requestLimits maxAllowedContentLength="12582912" /></requestFiltering></security>
  </system.webServer>
</configuration>
